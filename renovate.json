{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": ["config:base"],
  "gitIgnoredAuthors": ["githubaction@githubaction.com"],
  "rebaseWhen": "never",
  "packageRules": [
    {
      "matchPackageNames": ["docker-compose"],
      "automerge": true
    }
  ],
  "prCreation": "immediate"
}
